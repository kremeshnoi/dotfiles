[color]
	ui = true
[core]
	autocrlf = input
	editor = hx
	pager = delta
	eol = lf
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	line-numbers = true
	syntax-theme = GitHub Dark
[merge]
	conflictStyle = zdiff3
[pull]
	rebase = false
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[diff]
	algorithm = histogram
	colorMoved = default
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[init]
	defaultBranch = main
